{
  "manifest_version": 3,
  "name": "Central da Informação",
  "short_name": "Central",
  "version": "0.4.0",
  "description": "Quatro opções acessíveis para ler a página, consultar uma base inicial de checagens e ouvir o conteúdo com suas fontes.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Central da Informação — verificar uma informação",
    "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}
  },
  "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"},
  "side_panel": {"default_path": "panel.html"},
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+C"},
      "description": "Abrir o painel Central da Informação"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; connect-src 'self'"
  }
}
