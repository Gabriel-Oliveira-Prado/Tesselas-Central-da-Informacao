{
  "name": "central-da-informacao",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Site e extensão acessíveis para verificar notícias, texto, áudio e vídeo com fontes.",
  "scripts": {
    "start": "node scripts/servidor.mjs",
    "test": "node scripts/empacotar.mjs && node --test tests/*.test.mjs && playwright test",
    "test:unit": "node scripts/empacotar.mjs && node --test tests/*.test.mjs",
    "test:browser": "node scripts/empacotar.mjs && playwright test",
    "build": "node scripts/empacotar.mjs",
    "prestart": "node scripts/empacotar.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.62.1",
    "@tesseract.js-data/por": "1.0.0",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "tesseract.js": "6.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
